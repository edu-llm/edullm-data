{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReplicationServiceOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "s3.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "<ACCOUNT>"
        }
      }
    }
  ]
}
